program(1.3)
[buildInfo = dict<string, string>({})]
{
  func main<ios18>(tensor<fp16, [1, 384, 3000]> v10) {
    tensor<fp16, [384, 384, 3]> v16 = const()[name = string("v16"), val = tensor<fp16, [384, 384, 3]>(BLOBFILE(path = string("@model_path/weights.bin"), offset = uint64(185344)))];
    tensor<fp16, [384]> v17 = const()[name = string("v17"), val = tensor<fp16, [384]>(BLOBFILE(path = string("@model_path/weights.bin"), offset = uint64(1070144)))];
    tensor<int32, [1]> v13 = const()[name = string("v13"), val = tensor<int32, [1]>([2])];
    string v11 = const()[name = string("v11"), val = string("custom")];
    tensor<int32, [2]> v12 = const()[name = string("v12"), val = tensor<int32, [2]>([1, 1])];
    tensor<int32, [1]> v14 = const()[name = string("v14"), val = tensor<int32, [1]>([1])];
