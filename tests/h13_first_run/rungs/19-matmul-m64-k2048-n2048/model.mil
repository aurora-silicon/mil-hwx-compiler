program(1.3)
[buildInfo = dict<string, string>({})]
{
  func main<ios18>(tensor<fp16, [64, 2048]> x) {
    bool tx = const()[name = string("tx"), val = bool(false)];
    bool ty = const()[name = string("ty"), val = bool(true)];
    tensor<fp16, [2048, 2048]> W = const()[name = string("W"), val = tensor<fp16, [2048, 2048]>(BLOBFILE(path = string("@model_path/weights.bin"), offset = uint64(64)))];
    tensor<fp16, [64, 2048]> y = matmul(x = x, y = W, transpose_x = tx, transpose_y = ty)[name = string("y")];
  } -> (y);
}
