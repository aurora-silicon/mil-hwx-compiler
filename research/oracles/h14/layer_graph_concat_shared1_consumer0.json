  "mil": "program(1.3)\n[buildInfo = dict<string, string>({})]\n{\n  func main<ios18>(tensor<fp16, [1, 16, 16, 16]> x) {\n    string pt = const()[name = string(\"pt\"), val = string(\"same\")];\n    tensor<int32, [2]> st = const()[name = string(\"st\"), val = tensor<int32, [2]>([1,1])];\n    tensor<int32, [4]> pd = const()[name = string(\"pd\"), val = tensor<int32, [4]>([0,0,0,0])];\n    tensor<int32, [2]> dl = const()[name = string(\"dl\"), val = tensor<int32, [2]>([1,1])];\n    int32 gp = const()[name = string(\"gp\"), val = int32(1)];\n    tensor<fp16, [16, 16, 1, 1]> p0 = const()[name = string(\"p0\"), val = tensor<fp16, [16, 16, 1, 1]>(BLOBFILE(path = string(\"@model_path/weights.bin\"), offset = uint64(64)))];\n    tensor<fp16, [16]> p1 = const()[name = string(\"p1\"), val = tensor<fp16, [16]>(BLOBFILE(path = string(\"@model_path/weights.bin\"), offset = uint64(640)))];\n    tensor<fp16, [16, 16, 5, 5]> p2 = const()[name = string(\"p2\"), val = tensor<fp16, [16, 16, 5, 5]>(BLOBFILE(path = string(\"@model_path/weights.bin\"), offset = uint64(768)))];\n    tensor<fp16, [16]> p3 = const()[name = string(\"p3\"), val = tensor<fp16, [16]>(BLOBFILE(path = string(\"@model_path/weights.bin\"), offset = uint64(13632)))];\n    tensor<fp16, [1, 16, 16, 16]> a = conv(x = x, weight = p0, bias = p1, strides = st, dilations = dl, pad = pd, pad_type = pt, groups = gp)[name = string(\"a\")];\n    tensor<fp16, [1, 16, 16, 16]> b = conv(x = a, weight = p2, bias = p3, strides = st, dilations = dl, pad = pd, pad_type = pt, groups = gp)[name = string(\"b\")];\n    tensor<fp16, [1, 32, 16, 16]> y = concat(values = (a,b), axis = int32(1), interleave = bool(false))[name = string(\"concat\")];\n  } -> (y);\n}\n",
