  "mil": "program(1.3)\n[buildInfo = dict<string, string>({})]\n{\n  func main<ios18>(tensor<fp16, [1, 1, 16, 16]> x) {\n    fp16 three = const()[name = string(\"three\"), val = fp16(0x1.8p1)];\n    fp16 six = const()[name = string(\"six\"), val = fp16(0x1.8p2)];\n    tensor<fp16, [1, 1, 16, 16]> a = add(x = x, y = three)[name = string(\"a\")];\n    tensor<fp16, [1, 1, 16, 16]> b = relu6(x = a)[name = string(\"b\")];\n    tensor<fp16, [1, 1, 16, 16]> h = real_div(x = b, y = six)[name = string(\"h\")];\n    tensor<fp16, [1, 1, 16, 16]> y = mul(x = x, y = h)[name = string(\"y\")];\n  } -> (y);\n}\n",
