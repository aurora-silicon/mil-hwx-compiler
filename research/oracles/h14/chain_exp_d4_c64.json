  "mil": "program(1.3)\n[buildInfo = dict<string, string>({})]\n{\n  func main<ios18>(tensor<fp16, [1, 64, 1, 1]> x) {\n    fp16 k16 = const()[name = string(\"k16\"), val = fp16(0x1.c6p-9)];\n    fp16 sixteen = const()[name = string(\"sixteen\"), val = fp16(0x1p+4)];\n    fp16 sixteenth = const()[name = string(\"sixteenth\"), val = fp16(0x1p-4)];\n    tensor<fp16, [1, 64, 1, 1]> e = exp(x = x)[name = string(\"e\")];\n    tensor<fp16, [1, 64, 1, 1]> c = mul(x = x, y = k16)[name = string(\"c\")];\n    tensor<fp16, [1, 64, 1, 1]> g = add(x = c, y = sixteen)[name = string(\"g\")];\n    tensor<fp16, [1, 64, 1, 1]> p = mul(x = e, y = g)[name = string(\"p\")];\n    tensor<fp16, [1, 64, 1, 1]> y = mul(x = p, y = sixteenth)[name = string(\"y\")];\n  } -> (y);\n}\n",
