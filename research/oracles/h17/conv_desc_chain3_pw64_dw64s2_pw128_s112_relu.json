  "mil": "program(1.3)\n[buildInfo = dict<string, string>({})]\n{\n  func main<ios18>(tensor<fp16, [1, 32, 112, 112]> x) {\n    string s0_pt = const()[name = string(\"s0_pt\"), val = string(\"same\")];\n    tensor<int32, [2]> s0_st = const()[name = string(\"s0_st\"), val = tensor<int32, [2]>([1, 1])];\n    tensor<int32, [4]> s0_pd = const()[name = string(\"s0_pd\"), val = tensor<int32, [4]>([0, 0, 0, 0])];\n    tensor<int32, [2]> s0_dl = const()[name = string(\"s0_dl\"), val = tensor<int32, [2]>([1, 1])];\n    int32 s0_gp = const()[name = string(\"s0_gp\"), val = int32(1)];\n    tensor<fp16, [64, 32, 1, 1]> s0_w = const()[name = string(\"s0_w\"), val = tensor<fp16, [64, 32, 1, 1]>(BLOBFILE(path = string(\"@model_path/weights.bin\"), offset = uint64(64)))];\n    tensor<fp16, [1, 64, 112, 112]> s0_conv = conv(dilations = s0_dl, groups = s0_gp, pad = s0_pd, pad_type = s0_pt, strides = s0_st, weight = s0_w, x = x)[name = string(\"s0_conv\")];\n    tensor<fp16, [1, 64, 112, 112]> a = relu(x = s0_conv)[name = string(\"a\")];\n    string s1_pt = const()[name = string(\"s1_pt\"), val = string(\"same\")];\n    tensor<int32, [2]> s1_st = const()[name = string(\"s1_st\"), val = tensor<int32, [2]>([2, 2])];\n    tensor<int32, [4]> s1_pd = const()[name = string(\"s1_pd\"), val = tensor<int32, [4]>([0, 0, 0, 0])];\n    tensor<int32, [2]> s1_dl = const()[name = string(\"s1_dl\"), val = tensor<int32, [2]>([1, 1])];\n    int32 s1_gp = const()[name = string(\"s1_gp\"), val = int32(64)];\n    tensor<fp16, [64, 1, 3, 3]> s1_w = const()[name = string(\"s1_w\"), val = tensor<fp16, [64, 1, 3, 3]>(BLOBFILE(path = string(\"@model_path/weights.bin\"), offset = uint64(64)))];\n    tensor<fp16, [1, 64, 56, 56]> s1_conv = conv(dilations = s1_dl, groups = s1_gp, pad = s1_pd, pad_type = s1_pt, strides = s1_st, weight = s1_w, x = a)[name = string(\"s1_conv\")];\n    tensor<fp16, [1, 64, 56, 56]> b = relu(x = s1_conv)[name = string(\"b\")];\n    string s2_pt = const()[name = string(\"s2_pt\"), val = string(\"same\")];\n    tensor<int32, [2]> s2_st = const()[name = string(\"s2_st\"), val = tensor<int32, [2]>([1, 1])];\n    tensor<int32, [4]> s2_pd = const()[name = string(\"s2_pd\"), val = tensor<int32, [4]>([0, 0, 0, 0])];\n    tensor<int32, [2]> s2_dl = const()[name = string(\"s2_dl\"), val = tensor<int32, [2]>([1, 1])];\n    int32 s2_gp = const()[name = string(\"s2_gp\"), val = int32(1)];\n    tensor<fp16, [128, 64, 1, 1]> s2_w = const()[name = string(\"s2_w\"), val = tensor<fp16, [128, 64, 1, 1]>(BLOBFILE(path = string(\"@model_path/weights.bin\"), offset = uint64(64)))];\n    tensor<fp16, [1, 128, 56, 56]> s2_conv = conv(dilations = s2_dl, groups = s2_gp, pad = s2_pd, pad_type = s2_pt, strides = s2_st, weight = s2_w, x = b)[name = string(\"s2_conv\")];\n    tensor<fp16, [1, 128, 56, 56]> y = relu(x = s2_conv)[name = string(\"y\")];\n  } -> (y);\n}\n",
