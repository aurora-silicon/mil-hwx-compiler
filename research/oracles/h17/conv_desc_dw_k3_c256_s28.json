  "mil": "program(1.3)\n[buildInfo = dict<string, string>({})]\n{\n  func main<ios18>(tensor<fp16, [1, 256, 28, 28]> x) {\n    string s0_pt = const()[name = string(\"s0_pt\"), val = string(\"same\")];\n    tensor<int32, [2]> s0_st = const()[name = string(\"s0_st\"), val = tensor<int32, [2]>([1, 1])];\n    tensor<int32, [4]> s0_pd = const()[name = string(\"s0_pd\"), val = tensor<int32, [4]>([0, 0, 0, 0])];\n    tensor<int32, [2]> s0_dl = const()[name = string(\"s0_dl\"), val = tensor<int32, [2]>([1, 1])];\n    int32 s0_gp = const()[name = string(\"s0_gp\"), val = int32(256)];\n    tensor<fp16, [256, 1, 3, 3]> s0_w = const()[name = string(\"s0_w\"), val = tensor<fp16, [256, 1, 3, 3]>(BLOBFILE(path = string(\"@model_path/weights.bin\"), offset = uint64(64)))];\n    tensor<fp16, [1, 256, 28, 28]> y = conv(dilations = s0_dl, groups = s0_gp, pad = s0_pd, pad_type = s0_pt, strides = s0_st, weight = s0_w, x = x)[name = string(\"y\")];\n  } -> (y);\n}\n",
