  "mil": "program(1.3)\n[buildInfo = dict<string, string>({})]\n{\n  func main<ios18>(tensor<fp16, [1, 128, 56, 56]> x) {\n    string pt0 = const()[name = string(\"pt0\"), val = string(\"same\")];\n        tensor<int32, [2]> st0 = const()[name = string(\"st0\"), val = tensor<int32, [2]>([2, 2])];\n        tensor<int32, [4]> pd0 = const()[name = string(\"pd0\"), val = tensor<int32, [4]>([0, 0, 0, 0])];\n        tensor<int32, [2]> dl0 = const()[name = string(\"dl0\"), val = tensor<int32, [2]>([1, 1])];\n        int32 gp0 = const()[name = string(\"gp0\"), val = int32(1)];\n        tensor<fp16, [256, 128, 1, 1]> w0 = const()[name = string(\"w0\"), val = tensor<fp16, [256, 128, 1, 1]>(BLOBFILE(path = string(\"@model_path/weights.bin\"), offset = uint64(64)))];\n        tensor<fp16, [256]> b0 = const()[name = string(\"b0\"), val = tensor<fp16, [256]>(BLOBFILE(path = string(\"@model_path/weights.bin\"), offset = uint64(64)))];\n        tensor<fp16, [1, 256, 28, 28]> y0 = conv(bias = b0, dilations = dl0, groups = gp0, pad = pd0, pad_type = pt0, strides = st0, weight = w0, x = x)[name = string(\"y0\")];\n    string pt1 = const()[name = string(\"pt1\"), val = string(\"same\")];\n        tensor<int32, [2]> st1 = const()[name = string(\"st1\"), val = tensor<int32, [2]>([1, 1])];\n        tensor<int32, [4]> pd1 = const()[name = string(\"pd1\"), val = tensor<int32, [4]>([0, 0, 0, 0])];\n        tensor<int32, [2]> dl1 = const()[name = string(\"dl1\"), val = tensor<int32, [2]>([1, 1])];\n        int32 gp1 = const()[name = string(\"gp1\"), val = int32(256)];\n        tensor<fp16, [256, 1, 3, 3]> w1 = const()[name = string(\"w1\"), val = tensor<fp16, [256, 1, 3, 3]>(BLOBFILE(path = string(\"@model_path/weights.bin\"), offset = uint64(64)))];\n        tensor<fp16, [256]> b1 = const()[name = string(\"b1\"), val = tensor<fp16, [256]>(BLOBFILE(path = string(\"@model_path/weights.bin\"), offset = uint64(64)))];\n        tensor<fp16, [1, 256, 28, 28]> y1 = conv(bias = b1, dilations = dl1, groups = gp1, pad = pd1, pad_type = pt1, strides = st1, weight = w1, x = y0)[name = string(\"y1\")];\n    string pt2 = const()[name = string(\"pt2\"), val = string(\"same\")];\n        tensor<int32, [2]> st2 = const()[name = string(\"st2\"), val = tensor<int32, [2]>([1, 1])];\n        tensor<int32, [4]> pd2 = const()[name = string(\"pd2\"), val = tensor<int32, [4]>([0, 0, 0, 0])];\n        tensor<int32, [2]> dl2 = const()[name = string(\"dl2\"), val = tensor<int32, [2]>([1, 1])];\n        int32 gp2 = const()[name = string(\"gp2\"), val = int32(1)];\n        tensor<fp16, [256, 256, 1, 1]> w2 = const()[name = string(\"w2\"), val = tensor<fp16, [256, 256, 1, 1]>(BLOBFILE(path = string(\"@model_path/weights.bin\"), offset = uint64(64)))];\n        tensor<fp16, [256]> b2 = const()[name = string(\"b2\"), val = tensor<fp16, [256]>(BLOBFILE(path = string(\"@model_path/weights.bin\"), offset = uint64(64)))];\n        tensor<fp16, [1, 256, 28, 28]> y2 = conv(bias = b2, dilations = dl2, groups = gp2, pad = pd2, pad_type = pt2, strides = st2, weight = w2, x = y1)[name = string(\"y2\")];\n  } -> (y2);\n}\n",
