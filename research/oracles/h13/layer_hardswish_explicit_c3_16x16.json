  "mil": "program(1.3)\n[buildInfo = dict<string, string>({})]\n{\n  func main<ios18>(tensor<fp16, [1, 3, 16, 16]> x) {\n    fp16 alpha = const()[name = string(\"alpha\"), val = fp16(0x1.554p-3)];\n    fp16 beta = const()[name = string(\"beta\"), val = fp16(0x1p-1)];\n    tensor<fp16, [1, 3, 16, 16]> h = sigmoid_hard(x = x, alpha = alpha, beta = beta)[name = string(\"h\")];\n    tensor<fp16, [1, 3, 16, 16]> y = mul(x = x, y = h)[name = string(\"y\")];\n  } -> (y);\n}\n",
